<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BitKeyboard tidak meminta izin INTERNET: tidak ada data yang dikirim keluar. -->
    <!-- Mikrofon hanya dipakai saat tombol voice typing ditekan. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ package visibility untuk fitur voice typing. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="dev.retrobit.bitkeyboard.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="dev.retrobit.bitkeyboard.settings.KeyEditorActivity"
            android:exported="false"
            android:label="@string/key_editor_title" />

        <activity
            android:name="dev.retrobit.bitkeyboard.ime.VoiceInputActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/VoiceTheme" />

        <service
            android:name="dev.retrobit.bitkeyboard.ime.BitKeyboardService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
